# ÁLBUNS - outros cenários
############################################################

### Criar álbum com o artista errado -> 201 (corrigido no PUT mais abaixo)
POST {{baseUrl}}/albuns
Content-Type: application/json

{
  "titulo": "Cabeça Dinossauro",
  "anoLancamento": 1986,
  "artistaId": 1
}

### ERRO: artista inexistente -> 404
POST {{baseUrl}}/albuns
Content-Type: application/json

{
  "titulo": "Álbum órfão",
  "anoLancamento": 2010,
  "artistaId": 9999
}

### ERRO: ano no futuro -> 400
POST {{baseUrl}}/albuns
Content-Type: application/json

{
  "titulo": "Do futuro",
  "anoLancamento": 2999,
  "artistaId": 1
}

### ERRO: título vazio, ano < 1900 e sem artistaId -> 400 com errosDeCampo
POST {{baseUrl}}/albuns
Content-Type: application/json

{
  "titulo": "",
  "anoLancamento": 1800
}

### Listar álbuns (paginado)
GET {{baseUrl}}/albuns?page=0&size=20&sort=anoLancamento,desc

### Filtrar álbuns por ano (2020 -> folklore, evermore, Smile e Future Nostalgia)
GET {{baseUrl}}/albuns?ano=2020

### Filtrar álbuns por artista
GET {{baseUrl}}/albuns?artistaId=1&size=20

### Filtrar álbuns por ano + artista (2020 -> folklore e evermore)
GET {{baseUrl}}/albuns?ano=2020&artistaId=1

### Álbuns do artista (paginado, discografia completa da Taylor)
GET {{baseUrl}}/artistas/1/albuns?page=0&size=20&sort=anoLancamento,asc

### Álbuns do artista (discografia da Madonna, de 1983 a 2026)
GET {{baseUrl}}/artistas/7/albuns?page=0&size=20&sort=anoLancamento,asc

### ERRO: álbuns de artista inexistente -> 404
GET {{baseUrl}}/artistas/9999/albuns

### Buscar álbum por id -> 200
GET {{baseUrl}}/albuns/1

### ERRO: álbum inexistente -> 404
GET {{baseUrl}}/albuns/9999

### Atualizar álbum trocando de artista -> 200 (Cabeça Dinossauro vai para os Titãs)
PUT {{baseUrl}}/albuns/115
Content-Type: application/json

{
  "titulo": "Cabeça Dinossauro",
  "anoLancamento": 1986,
  "artistaId": 2
}

### ERRO: atualizar álbum para artista inexistente -> 404
PUT {{baseUrl}}/albuns/115
Content-Type: application/json

{
  "titulo": "Cabeça Dinossauro",
  "anoLancamento": 1986,
  "artistaId": 9999
}

### Músicas do álbum -> 200
GET {{baseUrl}}/albuns/1/musicas

############################################################
# EXCLUSÕES (rode por último)
############################################################

### ERRO: excluir artista com álbuns -> 409 (Taylor Swift tem 16 álbuns)
DELETE {{baseUrl}}/artistas/1

### Excluir álbum -> 204
DELETE {{baseUrl}}/albuns/115

### ERRO: excluir álbum inexistente -> 404
DELETE {{baseUrl}}/albuns/9999

### Excluir artista sem álbuns -> 204 (Titãs ficou sem álbuns depois da exclusão acima)
DELETE {{baseUrl}}/artistas/2
