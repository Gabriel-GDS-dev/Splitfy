### Catálogo - Artista e Álbum
# Os ids assumem um banco vazio e a execução em ordem:
#   artistas: 1 Taylor Swift, 2 Titãs, 3 Calvin Harris, 4 Demi Lovato, 5 Alok,
#             6 Katy Perry, 7 Madonna, 8 Dua Lipa
#   álbuns:   1 a 57 = discografias (álbuns de estúdio, em ordem de lançamento),
#             58 = Cabeça Dinossauro

@baseUrl = http://localhost:8080/api

############################################################
# ARTISTAS
############################################################

### Criar artista -> 201 + Location
POST {{baseUrl}}/artistas
Content-Type: application/json

{
  "nome": "Taylor Swift",
  "biografia": "Cantora e compositora norte-americana.",
  "pais": "Estados Unidos",
  "inicioCarreira": "2006-10-24"
}

### Criar segundo artista -> 201
POST {{baseUrl}}/artistas
Content-Type: application/json

{
  "nome": "Titãs",
  "pais": "Brasil",
  "inicioCarreira": "1982-01-01"
}

### Criar artista 3: Calvin Harris -> 201
POST {{baseUrl}}/artistas
Content-Type: application/json

{
  "nome": "Calvin Harris",
  "pais": "Reino Unido"
}

