### Catálogo - Artista e Álbum
# Os ids assumem um banco vazio: Taylor Swift = artista 1, Titãs = artista 2,
# álbuns da Taylor = 1 a 16 (em ordem de lançamento) e Cabeça Dinossauro = 17.

@baseUrl = http://localhost:8080/api

############################################################
# ARTISTAS
############################################################

### Criar artista -> 201 + Location
POST {{baseUrl}}/artistas
Content-Type: application/json

{
  "nome": "Taylor Swift",
  "biografia": "Cantora e compositora norte-americana.",
  "pais": "Estados Unidos",
  "inicioCarreira": "2006-10-24"
}

### Criar segundo artista -> 201
POST {{baseUrl}}/artistas
Content-Type: application/json

{
  "nome": "Titãs",
  "pais": "Brasil",
  "inicioCarreira": "1982-01-01"
}

### ERRO: criar artista sem nome e com data futura -> 400 com errosDeCampo
POST {{baseUrl}}/artistas
Content-Type: application/json

{
  "nome": "",
  "inicioCarreira": "2999-01-01"
}

### ERRO: JSON mal formatado -> 400
POST {{baseUrl}}/artistas
Content-Type: application/json

{ "nome": "Sem fechar"

### Listar artistas (paginado)
GET {{baseUrl}}/artistas?page=0&size=10&sort=nome,asc

### Buscar artistas por nome (parcial, ignora maiúsculas)
GET {{baseUrl}}/artistas?nome=swift

### Buscar artista por id -> 200
GET {{baseUrl}}/artistas/1

### ERRO: artista inexistente -> 404
GET {{baseUrl}}/artistas/9999

### ERRO: id inválido -> 400
GET {{baseUrl}}/artistas/abc

### Atualizar artista -> 200
PUT {{baseUrl}}/artistas/1
Content-Type: application/json

{
  "nome": "Taylor Swift",
  "biografia": "Cantora e compositora norte-americana, uma das artistas mais premiadas do Grammy.",
  "pais": "Estados Unidos",
  "inicioCarreira": "2006-10-24"
}

### ERRO: atualizar artista inexistente -> 404
PUT {{baseUrl}}/artistas/9999
Content-Type: application/json

{
  "nome": "Ninguém"
}

############################################################
# ÁLBUNS - discografia da Taylor Swift
# (álbuns de estúdio e regravações Taylor's Version)
############################################################

### Criar álbum 1/16: Taylor Swift (2006) -> 201 + Location
POST {{baseUrl}}/albuns
Content-Type: application/json

{
  "titulo": "Taylor Swift",
  "anoLancamento": 2006,
  "capaUrl": "https://example.com/capas/taylor-swift.jpg",
  "artistaId": 1
}

