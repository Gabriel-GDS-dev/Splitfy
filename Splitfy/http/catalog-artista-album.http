### Catálogo - Artista e Álbum
# Os ids assumem um banco vazio e a execução em ordem:
#   artistas: 1 Taylor Swift, 2 Titãs, 3 Calvin Harris, 4 Demi Lovato, 5 Alok,
#             6 Katy Perry, 7 Madonna, 8 Dua Lipa, 9 Kamaitachi, 10 Twenty One Pilots,
#             11 Depeche Mode, 12 Roxette, 13 Cyndi Lauper, 14 New Order
#   álbuns:   1 a 114 = discografias (álbuns de estúdio, em ordem de lançamento),
#             115 = Cabeça Dinossauro

@baseUrl = http://localhost:8080/api

############################################################
# ARTISTAS
############################################################

### Criar artista -> 201 + Location
POST {{baseUrl}}/artistas
Content-Type: application/json

{
  "nome": "Taylor Swift",
  "biografia": "Cantora e compositora norte-americana.",
  "pais": "Estados Unidos",
  "inicioCarreira": "2006-10-24"
}

