{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "services": {
    "frontend": {
      "root": "Splitfy/src/main/resources/static",
      "outputDirectory": "."
    },
    "splitfy": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "splitfy" } },
    { "source": "/swagger-ui.html", "destination": { "service": "splitfy" } },
    { "source": "/swagger-ui/:path*", "destination": { "service": "splitfy" } },
    { "source": "/v3/:path*", "destination": { "service": "splitfy" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
